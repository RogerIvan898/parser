# Опционально: переопределение config.json
MRKT_AUTH=
TG_API_ID=
TG_API_HASH=
# Ручной initData (если не используешь Telegram-клиент)
TG_INIT_DATA=
# Вход через mtcute (если нет MRKT_AUTH)
MRKT_USE_TELEGRAM=
# Пауза между запросами парсера (мс), батч коллекций в /models
PARSER_DELAY_MS=800
# Сколько запросов по 20 items на модель (--history без --feed-100), итого до PAGES×20 продаж
PARSER_FEED_PAGES=5
# CLI: --feed-100 / --feed-count 100 — цель 100 продаж/модель (API всё равно по 20 за POST)
# CLI: --from 871 — старт с позиции 871/N в логе
PARSER_FEED_TIMEOUT_MS=60000
# Пауза между кругами --history (мс)
PARSER_HISTORY_ROUND_MS=2400
